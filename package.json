{
  "name": "ezbz.ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"PORT=3001 tsx watch src/server.ts\" \"vite --config web/vite.config.ts\"",
    "dev:api": "PORT=3001 tsx watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.0",
    "libphonenumber-js": "^1.12.13",
    "openai": "^5.20.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
